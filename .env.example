# PostgreSQL
POSTGRES_USER=mailuser
POSTGRES_PASSWORD=mailpass
POSTGRES_DB=maildb
DATABASE_URL=postgresql+asyncpg://mailuser:mailpass@db:5432/maildb

# JWT
JWT_SECRET=replace-with-a-strong-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OpenAI (optional)
OPENAI_API_KEY=

# Hugging Face (optional) - use for local LLM inference if OpenAI not available
# Get an API key from https://huggingface.co/settings/tokens and set the model name you want to use (e.g. 'mistralai/Mistral-7B-Instruct')
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct

# Domain / mail
DOMAIN=kders.com
SMTP_HOST=mail.kders.com
POP3_HOST=mail.kders.com
BACKEND_URL=http://backend:8000
MAILDIR=./smtp_server/maildir

# Misc
PGVECTOR_ENABLED=false
